# Configuración de Entorno para Campo Directo Web
# Renombrar a .env.local para desarrollo local o cargar en el Dashboard de Vercel

# Número de WhatsApp oficial (código de país sin signos, ej: 5491112345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Correo electrónico institucional de contacto
NEXT_PUBLIC_CONTACT_EMAIL=

# Teléfono fijo o móvil visible
NEXT_PUBLIC_PHONE=

# URL de producción
NEXT_PUBLIC_SITE_URL=https://campodirecto.ar
